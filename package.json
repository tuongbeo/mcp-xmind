{
  "name": "mcp-xmind-cf",
  "version": "2.0.0",
  "description": "XMind MCP Server on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts test/unit",
    "test:integration": "vitest run --config vitest.config.ts test/integration",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "vitest run --config vitest.all.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "fast-xml-parser": "^4.5.3",
    "fflate": "^0.8.2",
    "uuid": "^11.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.4",
    "@cloudflare/workers-types": "^4.20260316.1",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.25.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "vitest": "^3.1.4",
    "wrangler": "^4.12.0"
  }
}
